{
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "power-drawer",
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": [
      "custom/power",
      "custom/reboot",
      "custom/lock",
      "custom/suspend"
    ],
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "shutdown now"
  },
  "custom/reboot": {
    "format": "",
    "tooltip": false,
    "on-click": "reboot"
  },
  "custom/lock": {
    "format": "",
    "tooltip": false,
    "on-click": "swaylock"
  },
  "custom/suspend": {
    "format": "",
    "tooltip": false,
    "on-click": "systemctl suspend"
  }
}
