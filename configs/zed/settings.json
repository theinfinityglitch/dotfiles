// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "tab_size": 4,
  "show_wrap_guides": true,
  "wrap_guides": [80, 120],
  "buffer_font_family": "Cascadia Mono NF",
  "terminal": {
    "font_family": "Cascadia Mono NF",
  },
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "window_decorations": "server",
  "project_panel": {
    "dock": "left",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "SIGNAL_00",
  },
  "languages": {
    "Lua": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "stylua",
          "arguments": [
            "--syntax=LuaJIT",
            "--respect-ignores",
            "--stdin-filepath",
            "{buffer_path}",
            "-",
          ],
        },
      },
    },
    "CSS": {
      "tab_size": 2,
      "hard_tabs": false,
    },
    "JSON": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": "language_server",
    },
    "JSONC": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": "language_server",
    },
  },
}
